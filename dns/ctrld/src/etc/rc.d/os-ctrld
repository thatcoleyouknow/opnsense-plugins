#!/bin/sh
#
# PROVIDE: ctrld
# REQUIRE: NETWORKING SERVERS unbound dnsmasq securelevel
# KEYWORD: shutdown
#
# Add the following to /etc/rc.conf.d/ctrld (written automatically by this
# plugin's configd template when the service is enabled) to start at boot:
#
# ctrld_enable="YES"
#
# ctrld has no FreeBSD-native rc.d integration of its own -- it ships as a
# bare binary (see dns/ctrld/docs/ctrld.md) -- so this wraps `ctrld run` in
# daemon(8) rather than depending on ctrld's own start/stop/service
# subcommands, whose exact FreeBSD behavior isn't confirmed. daemon(8)'s -f
# flag sends ctrld's own stdout/stderr to /dev/null; its actual log output
# goes to /var/log/ctrld.log instead, via the log_path set in the rendered
# ctrld.toml (see service/templates/OPNsense/Ctrld/ctrld.toml) -- viewable
# from Services > ctrld > Log.

. /etc/rc.subr

name="ctrld"
rcvar="ctrld_enable"

load_rc_config $name

: ${ctrld_enable:="NO"}
# /etc/controld/ctrld_active.toml, not the Jinja2-rendered
# /etc/controld/ctrld.toml directly -- ctrld_prestart's
# patch_listener_ips.php reads the latter but writes its
# resolved-listener-IP output to this separate runtime path, so that a
# plain restart (which doesn't re-render the template) still gets a fresh
# interface-IP resolution attempt every time. See that script's own
# header comment for the full reasoning. Deliberately NOT under /var/run:
# that's cleared on every boot, which would turn every one of the patch
# script's own failure/bail-out paths into "no config at all" instead of
# "start with the last known-good config" -- the exact failure class this
# whole plugin has already caused two real outages from.
: ${ctrld_config:="/etc/controld/ctrld_active.toml"}
: ${ctrld_bin:="/usr/local/bin/ctrld"}
: ${ctrld_pidfile:="/var/run/ctrld.pid"}
: ${ctrld_supervisor_pidfile:="/var/run/ctrld_supervisor.pid"}

# rc.subr's pidfile/procname must point at daemon(8)'s own supervisor
# process, not the ctrld child. daemon(8)'s own man page spells out why:
# "the --child-pidfile option will give you the child's ID to signal when
# you attempt to stop the service, causing daemon to restart the child" --
# i.e. with -r (restart) set, `service os-ctrld stop` killing only the child
# just makes the still-running supervisor immediately respawn it. Killing
# the *supervisor* (via -P) correctly forwards SIGTERM to the child first,
# then exits, with no restart. -p is kept too so the actual ctrld PID is
# still recorded somewhere, just not what rc.subr itself tracks.
pidfile="${ctrld_supervisor_pidfile}"
procname="/usr/sbin/daemon"
command="/usr/sbin/daemon"
# No -T (syslog tag): daemon(8)'s own man page says any syslog parameter,
# including -T alone, implicitly enables -S (syslog output) -- which then
# makes -f redirect stdout/stderr to syslog instead of purely /dev/null,
# contradicting this file's own comment above. ctrld already writes its
# full structured log straight to log_path, bypassing stdout/stderr for
# normal operation, so there's nothing here that should go to syslog at
# all -- -f alone is what actually gives the /dev/null behavior described
# above.
command_args="-c -f -r -P ${ctrld_supervisor_pidfile} -p ${ctrld_pidfile} ${ctrld_bin} run --config ${ctrld_config}"

# Runs after `configd template reload OPNsense/Ctrld` has produced
# ctrld.toml, immediately before ctrld actually reads it, regardless of
# which caller got here -- the GUI's Apply button (inherited
# ApiMutableServiceControllerBase::reconfigureAction(), which
# Api/ServiceController.php doesn't override), this plugin's own
# ctrld_configure_do() (boot/WAN-IP-change events, via the 'dns'
# plugin-hook group), or a bare `service os-ctrld restart` from the console.
# rc.subr's default restart is stop+start, so
# hooking both start and reload (not restart directly) already covers
# every real path to (re)starting ctrld -- this is deliberately the single
# choke point for listener IP resolution instead of a PHP-side call added
# at each caller, which is exactly the kind of "forgot one call site" bug
# that took down every listener, not just WireGuard's, on 2026-07-27 (see
# dns/ctrld/docs/ctrld.md's Troubleshooting section).
start_precmd="ctrld_prestart"
reload_precmd="ctrld_prestart"
ctrld_prestart()
{
    # rc.subr aborts start/reload entirely on a non-zero precmd exit -- so
    # a failure here (a future missing php require, a parse error, php
    # itself missing mid-upgrade) must never propagate as ctrld's own exit
    # status. The script's own try/catch already keeps a PHP-level
    # exception from mattering; this keeps a fatal PHP *process* failure
    # (which no in-script catch can intercept) from mattering either --
    # worst case, listener IPs just don't get patched this cycle, which is
    # a far smaller failure than ctrld refusing to start at all.
    /usr/local/bin/php -f /usr/local/opnsense/scripts/OPNsense/Ctrld/patch_listener_ips.php || true
}

# Without this, rc.subr rejects "reload" as an unrecognized directive and
# exits non-zero without touching the running process. `ctrld reload` is
# ctrld's own subcommand for telling an already-running instance to
# reload its config (confirmed in ctrld's own --help output), distinct
# from restarting the daemon(8)-wrapped process entirely. Wired up end to
# end via actions.d/actions_ctrld.conf's own [reload] entry, which just
# calls this script's own reload directive -- ApiMutableServiceController
# Base::reconfigureAction() (core OPNsense, invoked by this plugin's
# Apply buttons) doesn't currently take this path itself, since
# Api/ServiceController.php doesn't override reconfigureForceRestart()
# (defaults to always forcing a full restart instead), but a direct
# `service os-ctrld reload` from the console does, and reload_precmd above
# means listener IP resolution still runs correctly either way.
extra_commands="reload"
reload_cmd="ctrld_reload"
ctrld_reload()
{
    ${ctrld_bin} reload
}

run_rc_command "$1"
