<model>
    <mount>//OPNsense/ctrld/general</mount>
    <description>ctrld general configuration</description>
    <version>0.0.1</version>
    <items>
        <enabled type="BooleanField">
            <Default>0</Default>
            <Required>Y</Required>
        </enabled>
        <logLevel type="OptionField">
            <Default>info</Default>
            <Required>Y</Required>
            <OptionValues>
                <debug>debug</debug>
                <info>info</info>
                <warn>warn</warn>
                <error>error</error>
            </OptionValues>
        </logLevel>
        <localZoneResolverHost type="TextField">
            <Default>127.0.0.1</Default>
            <Required>Y</Required>
            <ValidationMessage>Enter a valid IP address of the local resolver used for zone delegation.</ValidationMessage>
            <Mask>/^[0-9a-fA-F.:]+$/</Mask>
        </localZoneResolverHost>
        <localZoneResolverPort type="IntegerField">
            <Default>53053</Default>
            <Required>Y</Required>
            <MinimumValue>1</MinimumValue>
            <MaximumValue>65535</MaximumValue>
            <ValidationMessage>Choose a port between 1 and 65535.</ValidationMessage>
        </localZoneResolverPort>
        <cacheEnable type="BooleanField">
            <Default>1</Default>
            <Required>Y</Required>
        </cacheEnable>
        <cacheSize type="IntegerField">
            <Default>4096</Default>
            <Required>Y</Required>
            <MinimumValue>1</MinimumValue>
            <ValidationMessage>Enter a positive number of cached records.</ValidationMessage>
        </cacheSize>
        <cacheTtlOverride type="IntegerField">
            <Default>0</Default>
            <Required>Y</Required>
            <MinimumValue>0</MinimumValue>
            <ValidationMessage>Enter 0 (use each record's real TTL) or a positive number of seconds.</ValidationMessage>
        </cacheTtlOverride>
        <cacheServeStale type="BooleanField">
            <Default>1</Default>
            <Required>Y</Required>
        </cacheServeStale>
    </items>
</model>
