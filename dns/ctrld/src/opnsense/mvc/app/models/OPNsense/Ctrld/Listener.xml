<model>
    <mount>//OPNsense/ctrld/listeners</mount>
    <description>ctrld listener configuration</description>
    <version>0.0.1</version>
    <items>
        <listeners>
            <listener type="ArrayField">
                <enabled type="BooleanField">
                    <Default>1</Default>
                    <Required>Y</Required>
                </enabled>
                <description type="TextField">
                    <Required>N</Required>
                    <Mask>/^[^'\r\n]*$/</Mask>
                    <ValidationMessage>Single quotes and line breaks aren't allowed -- this value is written into a TOML config file.</ValidationMessage>
                </description>
                <interface type=".\ListenerInterfaceField">
                    <Required>Y</Required>
                    <ValidationMessage>Select a specific interface/VLAN, or Loopback for the firewall's own DNS. Listeners can never be bound to all interfaces.</ValidationMessage>
                </interface>
                <ipVersion type="OptionField">
                    <Default>ipv4</Default>
                    <Required>Y</Required>
                    <OptionValues>
                        <ipv4>ipv4</ipv4>
                        <ipv6>ipv6</ipv6>
                    </OptionValues>
                </ipVersion>
                <port type="IntegerField">
                    <Default>53</Default>
                    <Required>Y</Required>
                    <MinimumValue>1</MinimumValue>
                    <MaximumValue>65535</MaximumValue>
                    <ValidationMessage>Choose a port between 1 and 65535.</ValidationMessage>
                </port>
            </listener>
        </listeners>
    </items>
</model>
